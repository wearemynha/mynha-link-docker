# Production template. Replace the placeholders through the deployment environment.
COMPOSE_PROJECT_NAME=mynha-link
LINKSTACK_IMAGE=ghcr.io/wearemynha/mynha-link:<version>

ALPINE_VERSION=3.23.5
NODE_VERSION=24-alpine

HTTP_SERVER_NAME=link.example.com
SERVER_ADMIN=admin@example.com

APP_ENV=production
APP_DEBUG=false
APP_URL=https://link.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warn
TZ=America/Sao_Paulo

POSTGRES_DB=mynha_link
POSTGRES_USER=mynha_link
# Required secret.
POSTGRES_PASSWORD=
DB_SSLMODE=disable

MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Mynha Link
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true

PHP_MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=8M
POST_MAX_SIZE=16M
