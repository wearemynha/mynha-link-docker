COMPOSE_PROJECT_NAME=mynha-link
LINKSTACK_IMAGE=ghcr.io/wearemynha/mynha-link:local

ALPINE_VERSION=3.23.5
NODE_VERSION=24-alpine

HTTP_PORT=8080
HTTPS_PORT=8443
HTTP_SERVER_NAME=localhost
HTTPS_SERVER_NAME=localhost
SERVER_ADMIN=admin@example.com

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=warn
TZ=America/Sao_Paulo

POSTGRES_DB=linkstack
POSTGRES_USER=linkstack
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_SSLMODE=disable

MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Mynha Link

PHP_MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=8M
POST_MAX_SIZE=16M
